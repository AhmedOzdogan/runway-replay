# Dependencies and builds
node_modules/
dist/
.venv/
*.egg-info/

# Caches
__pycache__/
.pytest_cache/
.ruff_cache/

# Editors and OS: keep only the shared extension recommendations
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Local env files (never commit secrets)
.env
.env.*

# Real processed days live on the `data` branch (see .github/workflows/data.yml);
# only sample.json is committed to main.
web/public/data/*.json.gz
web/public/data/latest.json

# Local AI assistant notes
CLAUDE.md
.claude/*

# Screen recordings: too big for git. Upload them where they're shown (GitHub's attachment CDN,
# Reddit) and keep the repo to the screenshots.
docs/media/
